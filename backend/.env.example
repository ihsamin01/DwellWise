# ── Supabase (client-side, safe to ship in the Flutter app) ──────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Server-side only (Edge Functions / admin scripts) — NEVER ship in app ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Third-party services ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key            # AI assistant (lib/services/gemini_service.dart)
GOOGLE_MAPS_API_KEY=your-maps-key         # maps (lib/services/google_maps_service.dart)
PAYMENT_PROVIDER_KEY=your-payment-key     # verification fee / rent payments
